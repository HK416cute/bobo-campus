# =============================================================================
# bobo 部署环境变量模板
# 用法：cp .env.example .env 然后按需修改。.env 不要提交到版本库。
# =============================================================================

# ---------- 命名前缀（同一台机器跑多套 bobo 服务时必改）----------
# 容器名 = <BOBO_CONTAINER_PREFIX>-mysql / -server / -web
# 数据卷名 = <BOBO_VOLUME_PREFIX>-mysql-data / -upload / -logs
# 默认 bobo-* 适合一台机器只跑这一套；若已存在同名容器（例如另一个 bobo 工程），
# 改成 bobo-campus 之类的独立前缀即可，两套服务就能共存。
BOBO_CONTAINER_PREFIX=bobo
BOBO_VOLUME_PREFIX=bobo

# ---------- 对外端口 ----------
# 站点端口：云服务器安全组里需要放行这个端口（或前面再挂一层 SLB/CDN）
WEB_PORT=80
# MySQL 对宿主机暴露的端口。生产环境建议不暴露：把 docker-compose.yml 里
# bobo-mysql 的 ports 段注释掉，然后这里改成 3306 也不会生效（更安全）。
MYSQL_PORT=3306

# ---------- 数据库 ----------
# root 密码：仅用于容器初始化与运维登录，建议 20 位以上随机串
MYSQL_ROOT_PASSWORD=change-me-root-password
# 应用库与业务账号（后端只用这个账号，不用 root）
MYSQL_DATABASE=bobo
MYSQL_USERNAME=bobo
MYSQL_PASSWORD=change-me-bobo-password

# ---------- 安全 ----------
# JWT 签名密钥：至少 32 字节，否则后端拒绝启动。
# 生成方式：openssl rand -base64 48
BOBO_JWT_SECRET=change-me-please-use-openssl-rand-base64-48-at-least-32-bytes
# 登录态有效期（分钟），默认 7 天
BOBO_JWT_EXPIRE_MINUTES=10080
# 管理员注册邀请码：留空则关闭「注册管理员」能力（推荐生产留空）
BOBO_ADMIN_REGISTER_CODE=
# 演示数据重置等运维接口开关：除非确实是演示环境，否则保持 false
BOBO_DEMO_ENABLED=false

# ---------- 运行参数 ----------
TZ=Asia/Shanghai
BOBO_LOG_LEVEL=info
# 生产建议按机器内存调整：2C2G 用默认值即可；4C8G 可以给到 -Xmx1024m
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# ---------- 镜像站（可选）----------
# 留空 = 使用 Docker Hub 官方镜像（maven / eclipse-temurin / node / nginx）。
# 国内服务器访问 Docker Hub 常常超时，此时填一个可用的镜像站前缀即可，
# 它会被拼到两个 Dockerfile 的 FROM 前面（注意结尾必须带 /）：
#   BOBO_REGISTRY=docker.1ms.run/
# MySQL 的镜像单独用下面这个变量指定（同样可以指向镜像站）。
BOBO_REGISTRY=
BOBO_MYSQL_IMAGE=mysql:8.0
