<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bobo.mapper.ReviewMapper">

    <resultMap id="ReviewVOMap" type="com.bobo.domain.vo.SimpleVos$ReviewVO">
        <id     property="reviewId"     column="review_id"/>
        <result property="orderId"      column="order_id"/>
        <result property="itemId"       column="item_id"/>
        <result property="itemTitle"    column="item_title"/>
        <result property="fromId"       column="from_id"/>
        <result property="fromNickname" column="from_nickname"/>
        <result property="fromAvatar"   column="from_avatar"/>
        <result property="toId"         column="to_id"/>
        <result property="toNickname"   column="to_nickname"/>
        <result property="score"        column="score"/>
        <result property="content"      column="content"/>
        <result property="role"         column="role"/>
        <result property="status"       column="status"/>
        <result property="createTime"   column="create_time"/>
    </resultMap>

    <select id="selectReviewPage" resultMap="ReviewVOMap">
        SELECT r.review_id, r.order_id, r.item_id, i.title AS item_title,
               r.from_id, fu.nickname AS from_nickname, fu.avatar AS from_avatar,
               r.to_id, tu.nickname AS to_nickname,
               r.score, r.content, r.role, r.status, r.create_time
        FROM bobo_review r
        LEFT JOIN bobo_user fu ON fu.user_id = r.from_id
        LEFT JOIN bobo_user tu ON tu.user_id = r.to_id
        LEFT JOIN bobo_item i  ON i.item_id = r.item_id
        <where>
            r.del_flag = 0
            <if test="q.keyword != null and q.keyword != ''">
                AND (r.content LIKE CONCAT('%', #{q.keyword}, '%')
                     OR i.title LIKE CONCAT('%', #{q.keyword}, '%'))
            </if>
            <if test="q.toId != null">
                AND r.to_id = #{q.toId}
            </if>
            <if test="q.fromId != null">
                AND r.from_id = #{q.fromId}
            </if>
            <if test="q.itemId != null">
                AND r.item_id = #{q.itemId}
            </if>
            <if test="q.status != null">
                AND r.status = #{q.status}
            </if>
        </where>
        ORDER BY r.create_time DESC, r.review_id DESC
    </select>

</mapper>
