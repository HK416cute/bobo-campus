<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bobo.mapper.MessageMapper">

    <resultMap id="MessageVOMap" type="com.bobo.domain.vo.SimpleVos$MessageVO">
        <id     property="messageId"      column="message_id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="fromId"         column="from_id"/>
        <result property="fromNickname"   column="from_nickname"/>
        <result property="fromAvatar"     column="from_avatar"/>
        <result property="toId"           column="to_id"/>
        <result property="content"        column="content"/>
        <result property="isRead"         column="is_read"/>
        <result property="createTime"     column="create_time"/>
    </resultMap>

    <select id="selectMessagePage" resultMap="MessageVOMap">
        SELECT m.message_id, m.conversation_id, m.from_id, u.nickname AS from_nickname,
               u.avatar AS from_avatar, m.to_id, m.content, m.is_read, m.create_time
        FROM bobo_message m
        LEFT JOIN bobo_user u ON u.user_id = m.from_id
        WHERE m.conversation_id = #{conversationId}
        ORDER BY m.message_id DESC
    </select>

</mapper>
